# Backend URL for LLM calls
# Mặc định dùng IP LAN của máy chạy server (điện thoại & máy cùng WiFi).
# Nếu debug qua USB (điện thoại không cùng WiFi):
#   adb reverse tcp:3000 tcp:3000
# rồi đổi thành: EXPO_PUBLIC_BACKEND_URL=http://localhost:3000
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# Robot WebSocket endpoint
EXPO_PUBLIC_ROBOT_WS_URL=ws://192.168.1.100:8080
