# Backend URL for LLM calls
# Không bắt buộc: app tự dò IP LAN của máy chạy server (hostUri từ Expo).
# Chỉ cần đặt biến này khi muốn ghi đè (ví dụ trỏ tới server deploy riêng).
# Nếu debug qua USB không cùng WiFi: adb reverse tcp:3000 tcp:3000
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# Robot WebSocket endpoint
EXPO_PUBLIC_ROBOT_WS_URL=ws://192.168.1.100:8080