{
  "expo": {
    "name": "Heritage Buddy",
    "slug": "heritage-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/heritech.png",
    "scheme": "heritagebuddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/heritech.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF3E7",
        "foregroundImage": "./assets/images/heritech.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/heritech.png"
      },
      "package": "com.heritagebuddy.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/heritech.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF3E7",
          "image": "./assets/images/heritech.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-speech-recognition",
      "expo-audio",
      "react-native-ble-plx",
      [
        "expo-camera",
        {
          "cameraPermission": "Buddy cần camera để nhận diện ký hiệu tay."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "root": "heritage-buddy-app/src/app"
      }
    }
  }
}
